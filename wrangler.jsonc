{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bbcc-website",
  "compatibility_date": "2026-07-01",
  "main": "worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  },
  // SITE_MODE is the source of truth for what visitors see: "holding" serves
  // the holding page on every route; "live" serves the real site. Flip it here
  // and deploy (workflow_dispatch), or temporarily in the Cloudflare dashboard
  // for an instant maintenance switch (reverts on next deploy).
  "vars": {
    "SITE_MODE": "holding"
  },
  "routes": [
    {
      "pattern": "bbcc.scot",
      "custom_domain": true
    },
    {
      "pattern": "www.bbcc.scot",
      "custom_domain": true
    }
  ]
}
