---
// Every route's <head>. Beyond the title and description this carries the share
// tags and the site-wide JSON-LD graph, so a new page gets both by default
// rather than by someone remembering to add them (#37).
import { getEntry } from "astro:content";
import { loadMeetings } from "../lib/gcal";
import { buildGraph } from "../lib/jsonld";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  /**
   * The URL this page is published at, when that differs from the route it is
   * built from. The holding page is the only case: it is built at /holding/ but
   * the worker serves it at /, and everything the page says about itself —
   * canonical, og:url, the URL a share preview is attributed to — has to name
   * the URL a reader can actually reach (#37).
   */
  canonicalPath?: string;
}

const { title, description, canonicalPath } = Astro.props;

const site = Astro.site!;
const canonical = new URL(canonicalPath ?? Astro.url.pathname, site);
// The share card is committed rather than hashed, so its URL survives rebuilds
// and stays valid in the caches at Facebook, LinkedIn, Slack and the rest.
const ogImage = new URL("/images/og-card.png", site);

const facts = (await getEntry("site", "index")).data;
// The same cached calendar read the pages use, so the structured data cannot
// name a different "next meeting" than the prose a few hundred lines below it.
const { meetings, rule } = await loadMeetings(
  facts.meetingCalendar.icsUrl,
  facts.meetingDetails,
  facts.venue.postalCode,
);
const graph = buildGraph(facts, site.href, meetings.slice(0, 3), rule);
---

<!doctype html>
<html lang="en-GB" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/images/bbcc-logo.svg" />
    <link rel="icon" type="image/png" href="/images/bbcc-logo.png" sizes="133x134" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={facts.legalName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content={`${facts.legalName}, the community council for Glasgow's city centre`}
    />

    {/*
      summary_large_image and nothing else. There is deliberately no
      twitter:site tag: the council's old X handle has been superseded, and
      since there is no markup meaning "this account is not ours", the only way
      to stop asserting a link is to bind the domain to no handle at all.
    */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
  </head>
  <body class="antialiased">
    <slot />
  </body>
</html>
