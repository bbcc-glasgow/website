---
// Inline SVG icon for a project CTA button. Icons are decorative
// (aria-hidden); the button label carries the accessible name. The allowed
// icon names live in src/lib/projectVariants.ts and the Decap CMS config;
// an unknown name renders nothing rather than a broken image.
interface Props {
  name: string;
}

const { name } = Astro.props;

const iconPaths: Record<string, string> = {
  "arrow-right": "M17 8l4 4m0 0l-4 4m4-4H3",
  external:
    "M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14",
  mail: "M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z",
  calendar:
    "M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z",
  "map-pin":
    "M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0zM15 11a3 3 0 11-6 0 3 3 0 016 0z",
  download: "M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4",
};
---

{
  iconPaths[name] ? (
    <svg
      class="w-4 h-4 flex-shrink-0"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" d={iconPaths[name]}></path>
    </svg>
  ) : null
}
