---
// Icon for a CTA button. Icons are decorative (aria-hidden); the button label
// carries the accessible name. The allowed icon names live in src/lib/cta.ts
// and the Decap CMS config; an unknown name renders nothing rather than a
// broken image.
//
// The map turns the site's own vocabulary ("external", "mail") into Heroicons
// names. Editors pick from a short list of things a button does, and are not
// asked to know what Heroicons calls the glyph for it.
import { Icon } from "astro-icon/components";

interface Props {
  name: string;
}

const { name } = Astro.props;

const icons: Record<string, string> = {
  "arrow-right": "heroicons:arrow-right",
  external: "heroicons:arrow-top-right-on-square",
  mail: "heroicons:envelope",
  calendar: "heroicons:calendar-days",
  "map-pin": "heroicons:map-pin",
  download: "heroicons:arrow-down-tray",
  document: "heroicons:document-text",
};

const icon = icons[name];
---

{icon && <Icon name={icon} class="w-4 h-4 flex-shrink-0" aria-hidden="true" />}
