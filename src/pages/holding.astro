---
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import { calendarLinks } from "../lib/calendar";
import { loadMeetings } from "../lib/gcal";
import { describeMeetingRule } from "../lib/meetings";

// The Holding Page is the second file entry in the Pages collection, distinct
// from the Homepage entry; this route always reads the Holding Page shape.
const holdingEntry = await getEntry("pages", "holding");
const { eyebrow, heading, body, ctaLabel } = holdingEntry.data as {
  eyebrow: string;
  heading: string;
  body: string;
  ctaLabel: string;
};

const siteEntry = await getEntry("site", "index");
const {
  contactEmail,
  legalName,
  description,
  boundaryDescription,
  venue,
  meetingCalendar,
  meetingDetails,
  areaPartnership,
} = siteEntry.data;

// While the site is in holding mode the worker serves this content at `/`, so
// whatever search and answer engines learn about the council now accrues to the
// URL that survives launch. That only pays off if the page states the facts, so
// it carries the same fact set as the homepage instead of an apology for being
// unfinished (#37). The `/holding/` URL itself is noindexed and kept out of the
// sitemap; `/` is where this content is meant to be found.
const { meetings: calendarMeetings, rule: meetingRule } = await loadMeetings(
  meetingCalendar.icsUrl,
  meetingDetails,
  venue.postalCode,
);
const upcomingMeetings = calendarMeetings.slice(0, 2);
const meetingRuleText = describeMeetingRule(meetingRule, meetingDetails);
const venueLine = `${venue.name}, ${venue.streetAddress}, ${venue.addressLocality} ${venue.postalCode}`;
const isHoldingUrl = Astro.url.pathname.startsWith("/holding");
const addToCalendar = calendarLinks(Astro.site!);
---

<Base
  title={`${legalName} | Glasgow City Centre`}
  description={`The statutory community council for Glasgow's city centre. Public meetings: ${meetingRuleText.toLowerCase().replace(/\.$/, "")} at ${venueLine}.`}
  noindex={isHoldingUrl}
>
  <main class="min-h-screen grid" style="grid-template-rows:1fr auto auto;">
    <div class="flex items-center justify-center px-4" style="background:var(--pink);">
      <div class="text-center max-w-lg py-16">
        <div class="w-16 h-16 mx-auto mb-6 overflow-hidden rounded-xl bg-white p-1">
          <img
            src="/images/bbcc-logo.svg"
            alt="Blythswood and Broomielaw Community Council logo"
            class="w-full h-full"
            width="64"
            height="64"
          />
        </div>
        <p class="section-eyebrow mb-4 text-white">{eyebrow}</p>
        <h1 class="font-fraunces font-bold text-white leading-tight mb-6" style="font-size:clamp(2.25rem,6vw,3.5rem);" set:html={heading}></h1>
        <p class="text-white mb-8 leading-relaxed" style="font-size:1.125rem;">
          {body}
        </p>
        <a
          href={`mailto:${contactEmail}`}
          class="btn font-semibold border-0 shadow-md"
          style="background:#fff;color:var(--pink);"
        >
          {ctaLabel}
        </a>
      </div>
    </div>

    {/*
      The facts, in plain prose. A reader who lands here should be able to find
      out when and where the council meets without waiting for the full site,
      and an assistant asked "when does BBCC meet" should be able to answer.
    */}
    <section class="px-4 py-16" style="background:#fff;" aria-labelledby="holding-facts">
      <div class="max-w-2xl mx-auto">
        <h2
          id="holding-facts"
          class="font-fraunces font-bold text-ink mb-6"
          style="font-size:clamp(1.5rem,3vw,2rem);"
        >
          About the council
        </h2>

        <p class="text-ink leading-relaxed mb-4">{description}</p>

        <p class="text-ink leading-relaxed mb-4">
          The council covers Glasgow's city centre between the M8 and Renfield Street.
          Its boundary runs {boundaryDescription.toLowerCase()}. It is part of the{" "}
          {areaPartnership.name}, under the {areaPartnership.parentBody}.
        </p>

        <h3 class="font-fraunces font-semibold text-ink mt-8 mb-3" style="font-size:1.25rem;">
          Public meetings
        </h3>

        <p class="text-ink leading-relaxed mb-4">
          {meetingRuleText} Meetings are held at {venueLine}, and they are open to
          everyone. {meetingDetails.attendanceNote} {venue.accessNote}
        </p>

        {
          upcomingMeetings.length > 0 && (
            <ul class="text-ink leading-relaxed mb-6" style="list-style:disc;padding-left:1.25rem;">
              {upcomingMeetings.map((m) => (
                <li>
                  <time datetime={m.date}>{m.longDate}</time>, {m.timeLabel}
                </li>
              ))}
            </ul>
          )
        }

        {/* Same disclosure as the homepage, on the light background. */}
        <details class="calendar-add calendar-add-light mb-6">
          <summary class="btn btn-sm font-semibold border" style="border-color:var(--pink);color:var(--pink);background:transparent;">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
            </svg>
            Add to your calendar
          </summary>

          <ul class="calendar-add-menu">
            {
              addToCalendar.map((link) => (
                <li>
                  <a href={link.href}>
                    <span>{link.label}</span>
                    <span class="calendar-add-note">
                      {link.subscribes ? "stays up to date" : "one-off download"}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>

          <p class="calendar-add-help">
            Subscribing means dates added or cancelled later reach you on their own. The
            file is a snapshot that stops updating the moment you import it.
          </p>
        </details>

        <p class="text-ink leading-relaxed">
          To ask a question, raise an issue or join the mailing list, email{" "}
          <a
            href={`mailto:${contactEmail}`}
            style="color:var(--pink);text-decoration:underline;">{contactEmail}</a
          >.
        </p>
      </div>
    </section>
    <footer class="py-6 px-4 text-center" style="background:var(--ink);">
      <p style="color:rgba(255,255,255,0.65);font-size:0.8125rem;">
        &copy; 2026 Blythswood &amp; Broomielaw Community Council &nbsp;·&nbsp;
        <a href={`mailto:${contactEmail}`} class="footer-link" style="color:var(--pink-on-dark);font-size:0.8125rem;text-decoration:underline;">{contactEmail}</a>
      </p>
    </footer>
  </main>
</Base>
