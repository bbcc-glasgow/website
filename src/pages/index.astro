---
import { Image, getImage } from "astro:assets";
import { getCollection, getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import ProjectCtaIcon from "../components/ProjectCtaIcon.astro";
import InstagramFeed from "../components/InstagramFeed.astro";
import { resolveProjectVariantColours } from "../lib/projectVariants";
import { calendarLinks } from "../lib/calendar";
import { loadMeetings } from "../lib/gcal";
import { describeMeetingRule } from "../lib/meetings";
import { FACEBOOK_HOST, INSTAGRAM_HOST, socialProfileUrl } from "../lib/social";
// Mark Ynys-Mon (Flickr: mym) gave permission on the condition that the page
// credits him with a link to his profile. The credit is in the footer; if this
// import ever goes, that line goes with it.
import dukeOfWellington from "../assets/duke_of_wellington_mym.jpeg";

// The source is 1067px wide, so that is the top of the hero srcset: asking for
// more would only make Sharp upscale a photo we cannot get bigger.
const heroWidths = [540, 768, 1067];
import blythswoodSquare from "../assets/blythswood-square.jpg";

const projects = (await getCollection("projects"))
  .map((p) => p.data)
  .sort((a, b) => a.order - b.order);
const siteEntry = await getEntry("site", "index");
const {
  stats,
  boundaryDescription,
  contactEmail,
  description,
  venue,
  meetingCalendar,
  meetingDetails,
  areaPartnership,
  officeBearers,
  socialProfiles,
} = siteEntry.data;

const instagramUrl = socialProfileUrl(socialProfiles, INSTAGRAM_HOST);
const facebookUrl = socialProfileUrl(socialProfiles, FACEBOOK_HOST);

// Meeting dates are read from the council's Google Calendar at build time, so
// the page never shows a date that has passed and nobody maintains a list of
// them here (#37). Cancelling a meeting in Google is the whole job. The daily
// rebuild in .github/workflows/deploy.yml is what carries a change across.
const { meetings: calendarMeetings, rule: meetingRule } = await loadMeetings(
  meetingCalendar.icsUrl,
  meetingDetails,
  venue.postalCode,
);
const upcomingMeetings = calendarMeetings.slice(0, 3);
const nextMeeting = upcomingMeetings[0];
const laterMeetings = upcomingMeetings.slice(1);
// What /meetings.ics actually contains, counted rather than assumed: a run of
// cancellations would make it fewer than CALENDAR_HORIZON, and the page should
// not promise a number the file does not hold.
const calendarCount = calendarMeetings.length;
const addToCalendar = calendarLinks(Astro.site!);
const meetingRuleText = describeMeetingRule(meetingRule, meetingDetails);
const venueLine = `${venue.name}, ${venue.streetAddress}, ${venue.addressLocality} ${venue.postalCode}`;
// A name is optional in content and is usually unconfirmed in an election year,
// so only office bearers who have one get named.
const namedBearers = officeBearers.filter((b) => b.name);
const pagesEntry = await getEntry("pages", "index");
const { hero, ourArea, ourProjects, jag, getInvolved, meetings, newsletter, instagram } =
  pagesEntry.data;

// Section order, layout and styling stay in code; only the copy lives in the
// Pages content entry. These arrays hold the per-card visual treatment so the
// template can map over the editable card copy without duplicating markup.
const pillarCardStyles = [
  { card: "background:var(--pink);", titleClass: "text-white", bodyClass: "text-white" },
  { card: "background:var(--teal-dark);", titleClass: "text-white", bodyClass: "text-white" },
  { card: "background:var(--amber);", titleStyle: "color:var(--ink);", bodyStyle: "color:rgba(26,26,46,0.85);" },
  { card: "background:rgba(255,255,255,0.07);border:1px solid rgba(255,255,255,0.15);", titleClass: "text-white", bodyStyle: "color:rgba(255,255,255,0.75);" },
];

const getInvolvedCardStyles = [
  {
    iconBg: "background:rgba(0,168,150,0.12);",
    iconColour: "var(--teal-dark)",
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"></path>',
    ctaClass: "text-white",
    ctaStyle: "background:var(--teal-dark);",
  },
  {
    iconBg: "background:rgba(244,161,0,0.12);",
    iconColour: "#8a5f00",
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-6 9l2 2 4-4"></path>',
    ctaClass: "text-ink",
    ctaStyle: "background:var(--amber);",
  },
  {
    iconBg: "background:rgba(220,26,132,0.08);",
    iconColour: "var(--pink)",
    iconPath: '<path stroke-linecap="round" stroke-linejoin="round" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path>',
    ctaClass: "text-white",
    ctaStyle: "background:var(--pink);",
  },
];
---

<Base
  title="Blythswood & Broomielaw Community Council"
  description="Blythswood & Broomielaw Community Council gives residents and workers a democratic voice in shaping the heart of Glasgow — planning, licensing, public realm, and community life in the city centre."
>
  <!-- Skip link for keyboard/screen-reader users -->
  <a href="#main-content" class="skip-link">Skip to main content</a>

  <!-- ═══ STICKY NAVBAR ═══ -->
  <nav id="navbar" aria-label="Main navigation">
    <div class="max-w-7xl mx-auto px-4 flex items-center justify-between h-16">
      <a href="#" class="flex items-center gap-3 no-underline">
        <div class="w-10 h-10 overflow-hidden rounded-md flex-shrink-0">
          <img
            src="/images/bbcc-logo.svg"
            alt="Blythswood and Broomielaw Community Council logo"
            class="w-full h-full"
            width="40"
            height="40"
          />
        </div>
        <span class="font-fraunces font-semibold text-ink text-lg leading-tight hidden sm:block">
          Blythswood &amp; Broomielaw
        </span>
      </a>

      <div class="hidden md:flex items-center gap-1">
        <a href="#our-area" class="nav-link">Our Area</a>
        <a href="#our-projects" class="nav-link">Projects</a>
        <a href="#meetings" class="nav-link">Meetings</a>
        <a href="#get-involved" class="nav-link">Get Involved</a>
        <a
          href="#get-involved"
          class="btn btn-sm text-white font-semibold border-0 ml-3"
          style="background:var(--pink);">Join Us</a
        >
      </div>

      <!-- Mobile hamburger -->
      <label for="mobile-drawer" class="md:hidden btn btn-ghost btn-sm p-2" aria-label="Open menu">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
      </label>
    </div>
  </nav>

  <!-- Mobile drawer (CSS-only) -->
  <input type="checkbox" id="mobile-drawer" class="drawer-toggle" aria-label="Toggle mobile menu" />
  <label for="mobile-drawer" class="drawer-overlay" aria-hidden="true"></label>
  <div class="mobile-menu">
    <div class="flex justify-between items-center mb-6">
      <span class="font-fraunces font-semibold text-ink text-base">Menu</span>
      <label for="mobile-drawer" class="btn btn-ghost btn-sm p-1" aria-label="Close menu">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </label>
    </div>
    <nav aria-label="Mobile navigation" class="flex flex-col gap-1">
      <a href="#our-area" class="nav-link block py-3 border-b border-gray-100">Our Area</a>
      <a href="#our-projects" class="nav-link block py-3 border-b border-gray-100">Projects</a>
      <a href="#meetings" class="nav-link block py-3 border-b border-gray-100">Meetings</a>
      <a href="#get-involved" class="nav-link block py-3 border-b border-gray-100">Get Involved</a>
      <a href="#get-involved" class="btn text-white border-0 mt-4 w-full" style="background:var(--pink);">Join Us</a>
    </nav>
  </div>

  <main id="main-content">
    <!-- ═══ HERO — SPLIT PINK / GLASGOW PHOTO ═══ -->
    <section id="home">
      <div class="hero-left">
        <div class="max-w-lg">
          <p class="section-eyebrow mb-5 text-white">
            {hero.eyebrow}
          </p>
          <h1 class="font-fraunces font-bold text-white leading-tight mb-6" set:html={hero.heading}></h1>
          <p class="text-white mb-8 leading-relaxed" style="font-size:1.125rem;max-width:38ch;">
            {hero.body}
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={hero.ctas[0].url} class="btn font-semibold border-0 shadow-md" style="background:#fff;color:var(--pink);">
              {hero.ctas[0].label}
            </a>
            <a
              href={hero.ctas[1].url}
              class="btn font-semibold border-2 bg-transparent text-white"
              style="border-color:rgba(255,255,255,0.7);"
            >
              {hero.ctas[1].label}
            </a>
          </div>
        </div>
      </div>
      <div class="hero-right">
        <Image
          src={dukeOfWellington}
          alt="The Duke of Wellington statue in Royal Exchange Square, Glasgow, wearing a traffic cone on its head"
          widths={heroWidths}
          sizes="(max-width: 767px) 100vw, 50vw"
          quality={65}
          loading="eager"
          fetchpriority="high"
        />
      </div>
    </section>

    <!-- ═══ STATS STRIP — TEAL ═══ -->
    <section id="stats" class="py-12 px-4">
      <div class="max-w-6xl mx-auto">
        <div class="stats stats-horizontal shadow-none divide-x divide-white/20 flex flex-wrap lg:flex-nowrap">
          {
            stats.map((stat, i) => (
              <div class="stat text-center px-6 py-4">
                <div
                  class="stat-value"
                  {...(stat.countValue !== undefined ? { "data-count": stat.countValue, "id": `count-${i}` } : {})}
                  {...(stat.prefix ? { "data-prefix": stat.prefix } : {})}
                  {...(stat.suffix ? { "data-suffix": stat.suffix } : {})}
                  {...(stat.duration ? { "data-duration": stat.duration } : {})}
                  style={stat.valueStyle || undefined}
                  set:html={stat.value}
                ></div>
                <div class="stat-title">{stat.label}</div>
                <div class="stat-desc">{stat.desc}</div>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ OUR AREA — INK DARK SECTION ═══ -->
    <section id="our-area" class="py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-start mb-16">
          <div>
            <p class="section-eyebrow mb-4" style="color:var(--teal);">{ourArea.eyebrow}</p>
            <h2 class="font-fraunces font-bold text-white leading-tight mb-6" style="font-size:clamp(2rem,3.5vw,2.75rem);">
              {ourArea.heading}
            </h2>
            <p class="leading-relaxed mb-6" style="color:rgba(255,255,255,0.75);font-size:1rem;">
              {ourArea.body1}
            </p>
            <p class="leading-relaxed mb-8" style="color:rgba(255,255,255,0.75);font-size:1rem;">
              {ourArea.body2}
            </p>
            <div class="boundary-box mb-6">
              <p class="font-semibold mb-1" style="color:var(--teal);">{ourArea.boundaryLabel}</p>
              <p style="color:rgba(255,255,255,0.75);font-size:0.9rem;line-height:1.6;">
                {boundaryDescription}
              </p>
            </div>

            {/*
              The plain statement of what the council is, who runs it and which
              partnership it sits in. Answer engines and readers arriving cold
              both need this in ordinary prose, not only in the markup (#37).
            */}
            <div class="boundary-box">
              <p class="font-semibold mb-1" style="color:var(--teal);">About the council</p>
              <p style="color:rgba(255,255,255,0.75);font-size:0.9rem;line-height:1.7;">
                {description}
              </p>
              <p class="mt-3" style="color:rgba(255,255,255,0.75);font-size:0.9rem;line-height:1.7;">
                It is part of the {areaPartnership.name}, under the {areaPartnership.parentBody}.
                The council is run by its elected members and office bearers
                ({officeBearers.map((b) => b.role).join(", ")}).
                {
                  namedBearers.length > 0 &&
                    ` Currently ${namedBearers.map((b) => `${b.role} ${b.name}`).join(", ")}.`
                }
                {" "}Reach any of them at{" "}
                <a href={`mailto:${contactEmail}`} style="color:var(--pink-on-dark);text-decoration:underline;">{contactEmail}</a>.
              </p>
            </div>
          </div>
          <div>
            <div class="rounded-2xl overflow-hidden" style="border:4px solid var(--pink);">
              <Image
                src={blythswoodSquare}
                alt="Springtime in Blythswood Square, Glasgow"
                class="w-full h-auto block"
                style="max-height:420px;object-fit:cover;"
                widths={[480, 800, 1200]}
                sizes="(max-width: 1023px) 100vw, 640px"
                quality={60}
              />
            </div>
          </div>
        </div>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          {
            ourArea.pillars.map((pillar, i) => {
              const s = pillarCardStyles[i] ?? pillarCardStyles[0];
              return (
                <div class="pillar-card" style={s.card}>
                  <h3 class={s.titleClass} style={s.titleStyle}>{pillar.heading}</h3>
                  <p class={s.bodyClass} style={s.bodyStyle}>{pillar.body}</p>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- ═══ PRIORITY PROJECTS — WHITE SECTION ═══ -->
    <section id="our-projects" class="py-20 px-4" style="background:#fff;">
      <div class="max-w-7xl mx-auto">
        <div class="text-center mb-12">
          <p class="section-eyebrow mb-3" style="color:var(--pink);">{ourProjects.eyebrow}</p>
          <h2 class="font-fraunces font-bold text-ink" style="font-size:clamp(2rem,3.5vw,2.75rem);">
            {ourProjects.heading}
          </h2>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
          {
            projects.map((p) => {
              const colours = resolveProjectVariantColours(p.variant);
              return (
                <div class="project-card">
                  <div class="card-top-border" style={`background:${colours.borderColour};`}></div>
                  <div class="card-body-custom">
                    <span class="badge card-tag border-0" style={`background:${colours.tagBgColour};color:${colours.tagColour};`}>{p.tag}</span>
                    <h3>{p.title}</h3>
                    <p>{p.summary}</p>
                    {
                      p.ctas && p.ctas.length > 0 && (
                        <div class="flex flex-wrap gap-2 mt-4">
                          {
                            p.ctas.map((cta) => (
                              <a
                                href={cta.url}
                                class="btn btn-sm border-0 text-white font-semibold inline-flex items-center gap-2"
                                style="background:var(--teal-dark);"
                              >
                                {cta.icon && <ProjectCtaIcon name={cta.icon} />}
                                {cta.label}
                              </a>
                            ))
                          }
                        </div>
                      )
                    }
                  </div>
                </div>
              );
            })
          }

          <div
            class="project-card flex flex-col items-center justify-center text-center p-8"
            style="opacity:1;transform:none;background:var(--paper);border:2px dashed rgba(26,26,46,0.15);"
          >
            <p class="font-fraunces font-semibold text-ink text-xl mb-3">{ourProjects.ideaCard.heading}</p>
            <p class="text-sm text-gray-600 mb-5">
              {ourProjects.ideaCard.body}
            </p>
            <a href={ourProjects.ideaCard.cta.url} class="btn btn-sm border-0 text-white font-semibold" style="background:var(--ink);">{ourProjects.ideaCard.cta.label}</a>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══ INSTAGRAM FEED — PAPER BAND ═══ -->
    <InstagramFeed copy={instagram} instagramUrl={instagramUrl} facebookUrl={facebookUrl} />

    <!-- ═══ JAG — NEIGHBOURING COUNCILS ═══ -->
    <section id="jag">
      <div style="max-width:72rem;margin:0 auto;">
        <p class="section-eyebrow" style="color:var(--teal);margin-bottom:0.75rem;">{jag.eyebrow}</p>
        <h2 class="font-fraunces" style="font-size:clamp(1.75rem,3vw,2.5rem);font-weight:600;color:white;line-height:1.2;margin-bottom:1.25rem;">
          {jag.heading}
        </h2>
        <p style="font-size:1rem;color:rgba(255,255,255,0.75);line-height:1.72;max-width:65ch;margin-bottom:3rem;">
          {jag.body}
        </p>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:1px;background:rgba(0,168,150,0.2);">
          {
            jag.cards.map((card) => (
              <a href="#jag" class="jag-card">
                <p class="section-eyebrow" style="font-size:0.65rem;color:var(--teal);margin-bottom:6px;">{card.eyebrow}</p>
                <h3 class="font-fraunces" style="font-size:1rem;font-weight:600;color:white;margin-bottom:6px;line-height:1.3;">
                  {card.heading}
                </h3>
                <p style="font-size:0.8rem;color:rgba(255,255,255,0.65);line-height:1.5;margin-bottom:14px;">
                  {card.body}
                </p>
                <span style="font-size:0.75rem;font-weight:700;color:var(--pink-on-dark);">{card.ctaLabel}</span>
              </a>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ═══ GET INVOLVED — PINK BACKGROUND ═══ -->
    <section id="get-involved" class="py-20 px-4">
      <div class="max-w-7xl mx-auto text-center">
        <p class="section-eyebrow mb-4 text-white">{getInvolved.eyebrow}</p>
        <h2 class="font-fraunces font-bold text-white mb-4" style="font-size:clamp(2.25rem,4vw,3.25rem);">
          {getInvolved.heading}
        </h2>
        <p class="text-white mb-12 mx-auto" style="font-size:1.0625rem;max-width:52ch;">
          {getInvolved.body}
        </p>

        <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
          {
            getInvolved.cards.map((card, i) => {
              const s = getInvolvedCardStyles[i] ?? getInvolvedCardStyles[0];
              return (
                <div class="card bg-white shadow-lg">
                  <div class="card-body text-left">
                    <div class="w-12 h-12 rounded-xl flex items-center justify-center mb-4" style={s.iconBg}>
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style={`color:${s.iconColour};`} aria-hidden="true" set:html={s.iconPath}></svg>
                    </div>
                    <h3 class="font-fraunces font-semibold text-ink text-xl mb-2">{card.heading}</h3>
                    <p class="text-gray-600 text-sm leading-relaxed mb-4">{card.body}</p>
                    <a href={card.cta.url} class={`btn btn-sm border-0 font-semibold ${s.ctaClass}`} style={s.ctaStyle}>{card.cta.label}</a>
                  </div>
                </div>
              );
            })
          }
        </div>
      </div>
    </section>

    <!-- ═══ MEETINGS — INK DARK SECTION ═══ -->
    <section id="meetings" class="py-20 px-4">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <p class="section-eyebrow mb-3" style="color:var(--teal);">{meetings.eyebrow}</p>
          <h2 class="font-fraunces font-bold text-white" style="font-size:clamp(2rem,3.5vw,2.75rem);">
            {meetings.heading}
          </h2>
        </div>

        <div class="meeting-card mb-6">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-4">
            <div>
              <p class="section-eyebrow text-xs mb-1" style="color:var(--teal);">Next Meeting</p>
              <h3 class="font-fraunces font-semibold text-white text-2xl">General Meeting</h3>
            </div>
            <span class="badge text-white border-0 font-medium px-4 py-3 text-sm" style="background:var(--teal-dark);">Open to all</span>
          </div>

          <div class="grid sm:grid-cols-3 gap-4 mb-6">
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--teal);" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              <div>
                <p class="text-xs font-semibold" style="color:rgba(255,255,255,0.7);">Date</p>
                <p class="text-white text-sm font-medium">
                  {nextMeeting ? <time datetime={nextMeeting.date}>{nextMeeting.longDate}</time> : "To be announced"}
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--teal);" aria-hidden="true">
                <circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>
              </svg>
              <div>
                <p class="text-xs font-semibold" style="color:rgba(255,255,255,0.7);">Time</p>
                <p class="text-white text-sm font-medium">
                  {nextMeeting ? nextMeeting.timeLabel : "To be announced"}
                </p>
              </div>
            </div>
            <div class="flex items-start gap-3">
              <svg class="w-5 h-5 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--teal);" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path><path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
              </svg>
              <div>
                <p class="text-xs font-semibold" style="color:rgba(255,255,255,0.7);">Location</p>
                <p class="text-white text-sm font-medium">
                  <span class="block">{venue.name}, {venue.streetAddress}</span>
                  <span class="block">{venue.addressLocality} {venue.postalCode}</span>
                </p>
              </div>
            </div>
          </div>

          <p class="text-sm mb-5" style="color:rgba(255,255,255,0.75);line-height:1.7;">
            {meetingDetails.attendanceNote} {venue.accessNote}
          </p>

          <div class="flex flex-wrap gap-3">
            <a href={meetings.cta.url} class="btn btn-sm font-semibold" style="background:var(--pink);color:#fff;border:0;">{meetings.cta.label}</a>
          </div>

          {/*
            A disclosure rather than a bare .ics link, because "add this to my
            calendar" is a different URL depending on which calendar you use, and
            handing everyone the file is the option that works worst for most of
            them. No script: <details> opens on click and on Enter and reports
            its expanded state to a screen reader for free.
          */}
          <details class="calendar-add mt-5">
            <summary
              class="btn btn-sm font-semibold border bg-transparent text-white"
              style="border-color:rgba(255,255,255,0.45);"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line>
              </svg>
              Add to your calendar
            </summary>

            <ul class="calendar-add-menu">
              {
                addToCalendar.map((link) => (
                  <li>
                    <a href={link.href}>
                      <span>{link.label}</span>
                      <span class="calendar-add-note">
                        {link.subscribes ? "stays up to date" : `${calendarCount} dates, one-off`}
                      </span>
                    </a>
                  </li>
                ))
              }
            </ul>

            <p class="calendar-add-help">
              Subscribing means dates added or cancelled later reach you on their own. The
              file is a snapshot of the next {calendarCount} meetings and stops updating the
              moment you import it.
            </p>
          </details>
        </div>

        {
          laterMeetings.length > 0 && (
            <div class="meeting-card mb-6">
              <p class="section-eyebrow text-xs mb-3" style="color:var(--teal);">
                Also coming up
              </p>
              <ul class="flex flex-col gap-2">
                {laterMeetings.map((m) => (
                  <li class="text-white text-sm">
                    <time datetime={m.date}>{m.longDate}</time>
                    <span style="color:rgba(255,255,255,0.65);">
                      {" "}
                      — {m.timeLabel}, {venueLine}
                    </span>
                  </li>
                ))}
              </ul>
            </div>
          )
        }

        <p class="text-center text-sm mb-3" style="color:rgba(255,255,255,0.8);">
          {meetingRuleText}
        </p>

        <p class="text-center text-sm" style="color:rgba(255,255,255,0.65);">
          {meetings.body}
        </p>
      </div>
    </section>

    <!-- ═══ NEWSLETTER — AMBER SECTION ═══ -->
    <section id="newsletter" class="py-20 px-4">
      <div class="max-w-2xl mx-auto text-center">
        <p class="section-eyebrow mb-4" style="color:rgba(26,26,46,0.85);">{newsletter.eyebrow}</p>
        <h2 class="font-fraunces font-bold text-ink mb-4" style="font-size:clamp(2rem,4vw,3rem);">
          {newsletter.heading}
        </h2>
        <p class="text-ink mb-8 leading-relaxed" style="font-size:1rem;">
          {newsletter.body}
        </p>

        <a
          href={`mailto:${contactEmail}?subject=Subscribe%20to%20BBCC%20updates`}
          class="btn border-0 font-semibold text-white px-8 shadow-lg"
          style="background:var(--ink);"
        >
          {newsletter.ctaLabel}
        </a>

        <p class="text-sm mt-4" style="color:rgba(26,26,46,0.85);">
          {newsletter.subtext}
        </p>
      </div>
    </section>
  </main>

  <!-- ═══ FOOTER — INK DARK ═══ -->
  <footer id="footer" class="pt-16 pb-8 px-4">
    <div class="max-w-7xl mx-auto">
      <div class="grid md:grid-cols-3 gap-10 pb-12 border-b" style="border-color:rgba(255,255,255,0.1);">
        <div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 overflow-hidden rounded-md flex-shrink-0">
              <img src="/images/bbcc-logo.svg" alt="Blythswood and Broomielaw Community Council logo" class="w-full h-full" width="40" height="40" loading="lazy" />
            </div>
            <span class="font-fraunces font-semibold text-white text-base leading-tight">
              Blythswood &amp;<br />Broomielaw CC
            </span>
          </div>
          <p style="color:rgba(255,255,255,0.65);font-size:0.875rem;line-height:1.6;max-width:28ch;">
            The statutory community council for the heart of Glasgow.
          </p>
        </div>

        <div>
          <p class="text-white font-semibold text-sm mb-4">Quick Links</p>
          <nav class="flex flex-col gap-2" aria-label="Footer navigation">
            <a href="#our-area" class="footer-link">Our Area</a>
            <a href="#our-projects" class="footer-link">Priority Projects</a>
            <a href="#meetings" class="footer-link">Meetings</a>
            <a href="#get-involved" class="footer-link">Get Involved</a>
            <a href="#newsletter" class="footer-link">Newsletter</a>
          </nav>
        </div>

        <div>
          <p class="text-white font-semibold text-sm mb-4">Contact</p>
          <p style="color:rgba(255,255,255,0.65);font-size:0.875rem;line-height:1.8;">
            Email:
            <a href={`mailto:${contactEmail}`} class="footer-link" style="color:var(--pink-on-dark);text-decoration:underline;">{contactEmail}</a>
          </p>
          <p style="color:rgba(255,255,255,0.65);font-size:0.875rem;margin-top:0.75rem;">
            Glasgow City Council area<br />
            Scotland, UK
          </p>
        </div>
      </div>

      <div class="pt-6 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-3">
        <p style="color:rgba(255,255,255,0.65);font-size:0.75rem;">
          &copy; 2026 Blythswood &amp; Broomielaw Community Council.
        </p>
        <p style="color:rgba(255,255,255,0.65);font-size:0.75rem;">
          Duke of Wellington photograph by
          <a
            href="https://www.flickr.com/photos/mymuk"
            rel="noopener"
            style="color:inherit;text-decoration:underline;">Mark Ynys-Mon</a>, used with permission.
          Other photos: Wikimedia Commons (Creative Commons).
        </p>
      </div>
    </div>
  </footer>

  <script>
    // ─── Navbar scroll shadow ──────────────────────────────────────
    const navbar = document.getElementById("navbar");
    window.addEventListener(
      "scroll",
      () => {
        if (!navbar) return;
        navbar.classList.toggle("scrolled", window.scrollY > 10);
      },
      { passive: true },
    );

    // ─── Animated stat counters (IntersectionObserver) ─────────────
    // Final values are server-rendered; the count-up is decoration only.
    function animateCount(el: HTMLElement, target: number, prefix: string, suffix: string, duration: number) {
      const start = performance.now();
      function update(ts: number) {
        const progress = Math.min((ts - start) / duration, 1);
        const eased = 1 - Math.pow(1 - progress, 3);
        const current = Math.round(target * eased);
        el.textContent = prefix + current.toLocaleString("en-GB") + suffix;
        if (progress < 1) requestAnimationFrame(update);
      }
      requestAnimationFrame(update);
    }

    const statsSection = document.getElementById("stats");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    let statsCounted = false;
    if (statsSection && !reducedMotion) {
      const statsObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !statsCounted) {
              statsCounted = true;
              const els = statsSection.querySelectorAll("[data-count]");
              els.forEach((el) => {
                const target = parseInt(el.getAttribute("data-count"), 10);
                if (isNaN(target)) return;
                const prefix = el.getAttribute("data-prefix") || "";
                const suffix = el.getAttribute("data-suffix") || "";
                const duration = parseInt(el.getAttribute("data-duration"), 10) || 2000;
                animateCount(el, target, prefix, suffix, duration);
              });
            }
          });
        },
        { threshold: 0.3 },
      );
      statsObs.observe(statsSection);
    }

    // ─── Project card scroll-reveal with stagger ──────────────────
    const projectCards = Array.from(document.querySelectorAll<HTMLElement>(".project-card"));
    if (reducedMotion) {
      projectCards.forEach((card) => card.classList.add("visible"));
    } else {
      const revealObs = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const card = entry.target as HTMLElement;
              const idx = projectCards.indexOf(card);
              setTimeout(() => card.classList.add("visible"), idx * 80);
              revealObs.unobserve(card);
            }
          });
        },
        { threshold: 0.1, rootMargin: "0px 0px -40px 0px" },
      );
      projectCards.forEach((card) => {
        if (!card.querySelector(".card-top-border")) return;
        revealObs.observe(card);
      });
    }

    // ─── Scroll-spy: highlight active nav link ────────────────────
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('a.nav-link[href^="#"]');
    if (navLinks.length) {
      const spy = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              const id = (entry.target as HTMLElement).id;
              navLinks.forEach((link) => {
                link.classList.toggle("nav-active", link.getAttribute("href") === "#" + id);
              });
            }
          });
        },
        { threshold: 0.25, rootMargin: "-10% 0px -55% 0px" },
      );
      document.querySelectorAll("section[id]").forEach((s) => spy.observe(s));
    }
  </script>
</Base>
