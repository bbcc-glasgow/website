{
  "name": "bbcc-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "cms": "decap-server",
    "prebuild": "node scripts/vendor-decap.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "test:links": "linkinator ./dist --recurse --verbosity error --skip \"^https?://\"",
    "test:a11y": "playwright test",
    "test:sitemap": "node --test tests/sitemap.test.mjs",
    "test:seo": "node --test tests/seo.test.mjs",
    "test:content": "node --test tests/cta.test.mjs tests/prose.test.mjs tests/content-schema.test.mjs tests/cache-headers.test.mjs tests/pages-content.test.ts tests/project-content.test.ts tests/decap-cms.test.ts tests/instagram-feed.test.ts",
    "test:gitignore": "node --experimental-strip-types --test tests/gitignore.test.ts",
    "test:instagram-feed": "node --experimental-strip-types --test tests/instagram-feed.test.ts",
    "test:instagram-refresh": "node --test tests/refresh-ig-token.test.mjs",
    "test:lighthouse": "lhci autorun",
    "gate": "./gate.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@iconify-json/heroicons": "^1.2.3",
    "@iconify-json/simple-icons": "^1.2.94",
    "astro": "^5.1.0",
    "astro-icon": "^1.2.0",
    "decap-cms": "3.16.0",
    "ical.js": "^2.2.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "daisyui": "^5.0.0",
    "decap-server": "^3.11.0",
    "linkinator": "^6.1.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0"
  }
}
