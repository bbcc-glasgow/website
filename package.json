{
  "name": "bbcc-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "cp node_modules/decap-cms/dist/decap-cms.js public/admin/decap-cms.js && cp node_modules/decap-cms/dist/373.decap-cms.js public/admin/373.decap-cms.js && cp node_modules/decap-cms/dist/cms.css public/admin/cms.css",
    "build": "astro build",
    "preview": "astro preview",
    "test:links": "linkinator ./dist --recurse --verbosity error --skip \"^https?://\"",
    "test:a11y": "playwright test",
    "test:sitemap": "node --test tests/sitemap.test.mjs",
    "test:gitignore": "node --experimental-strip-types --test tests/gitignore.test.ts",
    "test:instagram-feed": "node --experimental-strip-types --test tests/instagram-feed.test.ts",
    "test:instagram-refresh": "node --test tests/refresh-ig-token.test.mjs",
    "test:lighthouse": "lhci autorun",
    "gate": "./gate.sh"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "astro": "^5.1.0",
    "decap-cms": "3.11.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "daisyui": "^5.0.0",
    "linkinator": "^6.1.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0"
  }
}
