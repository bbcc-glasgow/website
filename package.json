{
  "name": "bbcc-website",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "test:links": "linkinator ./dist --recurse --verbosity error --skip \"^https?://\"",
    "test:a11y": "playwright test",
    "test:lighthouse": "lhci autorun",
    "gate": "pnpm build && pnpm test:links && pnpm test:a11y && pnpm test:lighthouse"
  },
  "dependencies": {
    "astro": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@fontsource-variable/fraunces": "^5.1.0",
    "@fontsource-variable/inter": "^5.1.0",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "1.49.1",
    "@tailwindcss/vite": "^4.0.0",
    "daisyui": "^5.0.0",
    "linkinator": "^6.1.2",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.0.0"
  }
}
